{
  "name": "jev-router-harness",
  "version": "1.0.0",
  "description": "AI TUI harness using Vercel Eve and typesafe-ai/jev dynamic model routing",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "jev-harness": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.{ts,tsx}'"
  },
  "keywords": [
    "ai",
    "tui",
    "eve",
    "jev",
    "model-routing",
    "ink"
  ],
  "author": "Michael Miller",
  "license": "MIT",
  "dependencies": {
    "ai": "^3.4.33",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.10.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.1"
  }
}
